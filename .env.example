# SYNK environment configuration (copy to .env and adjust)
# Never commit real credentials.

# --- Runtime environment ---
SYNK_ENV=development
SYNK_LOG_LEVEL=INFO
SYNK_RANDOM_SEED=42

# --- Paths (relative to repository root) ---
SYNK_CONFIG_DIR=configs
SYNK_DATA_DIR=data
SYNK_ARTIFACT_DIR=artifacts

# --- API ---
SYNK_API_HOST=0.0.0.0
SYNK_API_PORT=8000

# --- Database ---
# Default: local SQLite file (demo mode). For PostgreSQL use:
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/synk
DATABASE_URL=sqlite:///data/synk_demo.db

# --- Experiment tracking ---
# Leave empty to disable MLflow; e.g. http://localhost:5000 or file:./mlruns
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=synk
WANDB_API_KEY=

# --- Model / text encoder ---
# encoder_type: "transformer" (HuggingFace) or "tfidf" (lightweight, offline)
SYNK_TEXT_ENCODER_TYPE=tfidf
SYNK_TEXT_MODEL_NAME=emilyalsentzer/Bio_ClinicalBERT

# --- Streamlit ---
SYNK_API_URL=http://localhost:8000
